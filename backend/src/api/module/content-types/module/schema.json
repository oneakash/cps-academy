{
  "kind": "collectionType",
  "collectionName": "modules",
  "info": {
    "singularName": "module",
    "pluralName": "modules",
    "displayName": "Module",
    "description": "Course modules with detailed information"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Name": {
      "type": "string",
      "required": true
    },
    "Details": {
      "type": "blocks"
    },
    "NumberOfClasses": {
      "type": "integer",
      "default": 0
    },
    "TopicsCovered": {
      "type": "json",
      "default": {
        "topics": []
      }
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "modules"
    },
    "Order": {
      "type": "integer",
      "default": 0
    }
  }
}
